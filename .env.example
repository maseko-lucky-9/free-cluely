# free-cluely runs entirely on local Ollama. No cloud API key is used.
#
# Prerequisites:
#   brew install ollama && ollama serve
#   ollama pull qwen2.5vl:7b     # must be a VISION model - the app sends screenshots

USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434

# Benchmarked on Apple M5 Pro / 24 GB across 70 sequential runs.
# qwen3.5:9b won: 31/31 valid JSON, 20/20 executed-correct on easy problems,
# 6.0 GB fully GPU-resident, and it fails VISIBLY rather than silently.
# Leave unset to auto-select the first installed vision model - but note that
# qwen2.5vl:7b, while faster, can return schema-valid JSON containing only
# "using System;" on hard problems.
OLLAMA_MODEL=qwen3.5:9b

# Fallback language when the screenshot does not indicate one.
# The language is normally auto-detected from the screenshot itself.
# DEFAULT_LANGUAGE=Python

# Tuning. num_ctx must be large enough for a full-resolution screenshot;
# Ollama's ~2048 default silently truncates it.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=2048
# OLLAMA_TIMEOUT_MS=180000
# OLLAMA_KEEP_ALIVE=10m
# OLLAMA_THINK_LEVEL=low        # gpt-oss models only
